include "include/robots.inc"

resolution 0.02
interval_sim 100

define floorplan model
(
  color "gray30"
  boundary 1
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

window
(
  size [1000 600]
  scale 40
  center [-5.6500 -0.7550]
  rotate [0 0]
  show_data 1
)

floorplan
(
  name "laboratorio"
  size [21.3000 9.8500 0.800]
  pose [-5.6500 -0.7550 0 0]
  bitmap "bitmaps/laboratorio_stage.png"
  gui_move 0
)

pioneer2dx_with_laser
(
  name "robot_0"
  color "red"
  pose [-7.2250 -1.8550 0 0]
)
