# Aproximacion geometrica 2D de TB4 Standard; no replica fisica.
define tb4_lidar ranger
(
  sensor
  (
    pose [0 0 0 0]
    size [0.071 0.100 0.060]
    range [0.164 12.0]
    fov 360
    samples 640
    color_rgba [0 0 1 0.15]
  )
)
define tb4_standard position
(
  size [0.342 0.339 0.351]
  drive "diff"
  gui_nose 1
  obstacle_return 1
  ranger_return 1
  # Mantener referencia ideal para primeras pruebas; odometria con error despues.
  localization "gps"
  localization_origin [0 0 0 0]
  # Limites iniciales conservadores, no especificaciones certificadas.
  velocity_bounds [-0.30 0.30 0 0 0 0 -90 90]
  acceleration_bounds [-0.5 0.5 0 0 0 0 -90 90]
  block
  (
    points 24
    point[0] [0.171000 0.000000]
    point[1] [0.165173 0.043870]
    point[2] [0.148090 0.084750]
    point[3] [0.120915 0.119855]
    point[4] [0.085500 0.146791]
    point[5] [0.044258 0.163724]
    point[6] [0.000000 0.169500]
    point[7] [-0.044258 0.163724]
    point[8] [-0.085500 0.146791]
    point[9] [-0.120915 0.119855]
    point[10] [-0.148090 0.084750]
    point[11] [-0.165173 0.043870]
    point[12] [-0.171000 0.000000]
    point[13] [-0.165173 -0.043870]
    point[14] [-0.148090 -0.084750]
    point[15] [-0.120915 -0.119855]
    point[16] [-0.085500 -0.146791]
    point[17] [-0.044258 -0.163724]
    point[18] [-0.000000 -0.169500]
    point[19] [0.044258 -0.163724]
    point[20] [0.085500 -0.146791]
    point[21] [0.120915 -0.119855]
    point[22] [0.148090 -0.084750]
    point[23] [0.165173 -0.043870]
    z [0 0.351]
  )
  # Desplazamiento y yaw de la version Standard de Humble.
  tb4_lidar (pose [-0.04 0 0 90])
)


resolution 0.02
interval_sim 100

define floorplan model
(
  color "gray30"
  boundary 1
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

window
(
  size [1000 600]
  scale 40
  center [-5.6500 -0.7550]
  rotate [0 0]
  show_data 1
)

floorplan
(
  name "laboratorio"
  size [21.3000 9.8500 0.800]
  pose [-5.6500 -0.7550 0 0]
  bitmap "bitmaps/laboratorio_stage.png"
  gui_move 0
)

tb4_standard
(
  name "robot_0"
  color "red"
  pose [-7.2250 -1.8550 0 0]
)
